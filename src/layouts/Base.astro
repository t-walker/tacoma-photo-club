---
import site from "../data/site.json";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.slogan}`;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

const links = [
  { label: "Home", href: withBase("/") },
  { label: "Events", href: withBase("/events/") },
  { label: "Photo Labs", href: withBase("/photo-labs/") },
  { label: "Discord", href: site.discordUrl, external: true },
];

const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => !href.startsWith("http") && (href.replace(/\/+$/, "") || "/") === here;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(withBase("/og-image.png"), Astro.site ?? Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2efea" />
    <link rel="icon" href={withBase("/icon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase("/icon-512.png")} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={withBase("/icon-180.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700&family=Caveat:wght@500;700&display=swap"
    />
  </head>
  <body>
    <div class="sheet">
      <header class="masthead">
        <div class="masthead__kicker">
          <span>{site.name}</span>
          <span>Tacoma, Washington</span>
        </div>
        <nav class="nav" aria-label="Primary">
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                data-external={link.external ? "" : undefined}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="colophon">
        <span>{site.name} · {site.slogan}</span>
        <span>
          <a href={site.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>
          {site.instagram ? " · " : ""}
          {
            site.instagram && (
              <a href={site.instagram} target="_blank" rel="noopener noreferrer">
                Instagram
              </a>
            )
          }
        </span>
      </footer>
    </div>
  </body>
</html>
