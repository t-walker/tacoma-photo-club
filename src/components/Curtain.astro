---
/**
 * Pre-launch curtain: a blank white screen with nothing but the logo, which
 * slowly tiles over with members' work. Typing the club initials lifts it.
 */
import { Image } from "astro:assets";
import logo from "../images/brand/tpc-logo-white.png";
import { getCurtainTiles } from "../lib/images";

const tiles = await getCurtainTiles();
---

<div class="curtain" id="curtain" role="presentation">
  <div class="curtain__mosaic" id="curtain-mosaic" aria-hidden="true"></div>
  <Image
    class="curtain__logo"
    src={logo}
    alt="Tacoma Photo Club"
    widths={[480, 720, 1080, 1560]}
    sizes="(min-width: 1100px) 780px, 72vw"
    loading="eager"
  />
</div>

<script type="application/json" id="curtain-tiles" set:html={JSON.stringify(tiles)} />

<style is:global>
  /* The curtain is rendered into every page and only removed once the unlock
     script runs, so a visitor without the key never sees the site underneath. */
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background-color: #fff;
    overflow: hidden;
  }

  .curtain__mosaic {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--curtain-cols, 6), 1fr);
    grid-auto-rows: var(--curtain-cell, 1fr);
  }

  .curtain__cell {
    aspect-ratio: 1;
    background-position: center;
    background-size: cover;
    opacity: 0;
  }

  .curtain__cell[data-shown] {
    opacity: 1;
  }

  .curtain__logo {
    position: relative;
    /* Sits above the mosaic, so photos fill in behind the mark. */
    z-index: 1;
    width: clamp(300px, 72vw, 780px);
    height: auto;
    /* Kept tight and dark, so the white mark reads as negative space cut out of
       the photos rather than as a glow floating over them. */
    filter: drop-shadow(0 1px 4px rgba(16, 36, 58, 0.55));
  }

  html:not([data-tpc-curtain="down"]) {
    overflow: hidden;
  }

  html:not([data-tpc-curtain="down"]) body > .sheet {
    /* Kept in the DOM, so the page is ready the instant the curtain lifts, but
       out of reach of screen readers and the tab order. */
    visibility: hidden;
  }

  html[data-tpc-curtain="down"] .curtain {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .curtain {
      transition: opacity 450ms ease;
    }

    .curtain[data-lifting] {
      opacity: 0;
      pointer-events: none;
    }

    .curtain__cell {
      transition: opacity 400ms ease;
    }
  }
</style>

<script is:inline>
  (() => {
    const SECRET = "tpc";
    const root = document.documentElement;

    /* Deliberately not remembered: every load, reload and navigation drops the
       curtain again, so the visitor has to know the word each time. */
    const lift = () => {
      root.dataset.tpcCurtain = "down";
    };

    let typed = "";
    document.addEventListener("keydown", (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key.length !== 1) return;

      typed = (typed + event.key.toLowerCase()).slice(-SECRET.length);
      if (typed !== SECRET) return;

      const curtain = document.getElementById("curtain");
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!curtain || reduced) {
        lift();
        return;
      }

      curtain.dataset.lifting = "";
      curtain.addEventListener("transitionend", lift, { once: true });
      setTimeout(lift, 600);
    });
  })();
</script>

<script is:inline>
  (() => {
    const mosaic = document.getElementById("curtain-mosaic");
    const payload = document.getElementById("curtain-tiles");
    if (!mosaic || !payload) return;

    /** @type {{ src: string }[]} */
    let sources = [];
    try {
      sources = JSON.parse(payload.textContent || "[]");
    } catch {
      /* No tiles is a fine outcome — the curtain simply stays blank white. */
    }
    if (!sources.length) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const shuffle = (items) => {
      const out = items.slice();
      for (let i = out.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [out[i], out[j]] = [out[j], out[i]];
      }
      return out;
    };

    /**
     * Deals photos from a reshuffled deck rather than picking at random, so the
     * whole membership is on screen before anyone's frame shows up twice.
     */
    const dealer = () => {
      let deck = [];
      return () => {
        if (!deck.length) deck = shuffle(sources);
        return deck.pop();
      };
    };

    let timer = 0;
    const build = () => {
      window.clearTimeout(timer);
      mosaic.textContent = "";

      const target = window.innerWidth < 640 ? 88 : 132;
      const cols = Math.max(2, Math.round(window.innerWidth / target));
      const cell = window.innerWidth / cols;
      const rows = Math.ceil(window.innerHeight / cell);

      mosaic.style.setProperty("--curtain-cols", String(cols));
      mosaic.style.setProperty("--curtain-cell", `${cell}px`);

      const draw = dealer();
      const cells = [];
      for (let i = 0; i < cols * rows; i += 1) {
        const div = document.createElement("div");
        div.className = "curtain__cell";
        div.style.backgroundImage = `url("${draw().src}")`;
        mosaic.append(div);
        cells.push(div);
      }

      const order = shuffle(cells);
      if (reduced) {
        order.forEach((div) => div.setAttribute("data-shown", ""));
        return;
      }

      /* Spread the fill over roughly the same stretch of time no matter how
         many cells the viewport asked for. */
      const step = Math.max(16, Math.round(5000 / order.length));
      let next = 0;
      const reveal = () => {
        order[next].setAttribute("data-shown", "");
        next += 1;
        if (next < order.length) timer = window.setTimeout(reveal, step);
      };
      timer = window.setTimeout(reveal, 150);
    };

    build();

    let resizeTimer = 0;
    let lastWidth = window.innerWidth;
    let lastHeight = window.innerHeight;
    window.addEventListener("resize", () => {
      /* Mobile browsers fire resize as the URL bar hides; only a real change in
         layout is worth throwing away a half-filled mosaic. */
      if (Math.abs(window.innerWidth - lastWidth) < 40 && Math.abs(window.innerHeight - lastHeight) < 120) {
        return;
      }
      lastWidth = window.innerWidth;
      lastHeight = window.innerHeight;
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(build, 250);
    });
  })();
</script>
