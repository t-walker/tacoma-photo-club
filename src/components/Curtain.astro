---
/**
 * Pre-launch curtain: a blank white screen with nothing but the logo, which
 * slowly tiles over with members' work. Clicking the logo lifts it for good.
 */
import { Image } from "astro:assets";
import logo from "../images/brand/tpc-logo-white.png";
import { getCurtainTiles } from "../lib/images";

const tiles = await getCurtainTiles();
---

<div class="curtain" id="curtain" role="presentation">
  <div class="curtain__mosaic" id="curtain-mosaic" aria-hidden="true"></div>
  <button class="curtain__key" id="curtain-key" type="button" aria-label="Enter Tacoma Photo Club">
    <Image
      class="curtain__logo"
      src={logo}
      alt=""
      widths={[480, 720, 1080, 1560]}
      sizes="(min-width: 1100px) 780px, 72vw"
      loading="eager"
    />
  </button>
</div>

<script type="application/json" id="curtain-tiles" set:html={JSON.stringify(tiles)} />

<style is:global>
  /* The curtain is rendered into every page and only removed once the visitor
     has clicked through it, so the site is never glimpsed before the greeting. */
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background-color: #fff;
    overflow: hidden;
  }

  .curtain__mosaic {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--curtain-cols, 6), 1fr);
    grid-auto-rows: var(--curtain-cell, 1fr);
  }

  .curtain__cell {
    aspect-ratio: 1;
    background-position: center;
    background-size: cover;
    opacity: 0;
  }

  .curtain__cell[data-shown] {
    opacity: 1;
  }

  /* A scrim over the photos, so the white mark keeps its contrast no matter
     which frames happen to land behind it. */
  .curtain::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(10, 22, 36, 0.42);
    pointer-events: none;
  }

  .curtain__key {
    position: relative;
    /* Sits above the mosaic, so photos fill in behind the mark. */
    z-index: 1;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-origin: center;
  }

  .curtain__key:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 16px;
    border-radius: 4px;
  }

  .curtain__logo {
    display: block;
    width: clamp(300px, 72vw, 780px);
    height: auto;
    /* Kept tight and dark, so the white mark reads as negative space cut out of
       the photos rather than as a glow floating over them. */
    filter: drop-shadow(0 1px 4px rgba(16, 36, 58, 0.55));
  }

  html:not([data-tpc-curtain="down"]) {
    overflow: hidden;
  }

  html:not([data-tpc-curtain="down"]) body > .sheet {
    /* Kept in the DOM, so the page is ready the instant the curtain lifts, but
       out of reach of screen readers and the tab order. */
    visibility: hidden;
  }

  html[data-tpc-curtain="down"] .curtain {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .curtain {
      transition: opacity 450ms ease;
    }

    .curtain[data-lifting] {
      opacity: 0;
      pointer-events: none;
    }

    .curtain__cell {
      transition: opacity 400ms ease;
    }

    .curtain__key {
      transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), opacity 400ms ease;
    }

    /* Held back until the mosaic has finished dealing itself out, so the glow
       reads as an invitation rather than as part of the loading. */
    .curtain[data-ready] .curtain__logo {
      animation: curtain-beckon 3.8s ease-in-out infinite;
    }

    .curtain[data-ready] .curtain__key:hover,
    .curtain[data-ready] .curtain__key:focus-visible {
      transform: scale(1.04);
    }

    .curtain[data-ready] .curtain__key:hover .curtain__logo,
    .curtain[data-ready] .curtain__key:focus-visible .curtain__logo {
      animation: none;
      filter: drop-shadow(0 1px 4px rgba(16, 36, 58, 0.55)) drop-shadow(0 0 34px rgba(255, 255, 255, 0.75));
    }

    .curtain[data-exiting] .curtain__key {
      transform: scale(0.12);
      opacity: 0;
      transition: transform 620ms cubic-bezier(0.65, 0, 0.35, 1), opacity 520ms ease-in 120ms;
      pointer-events: none;
    }

    .curtain[data-exiting] .curtain__logo {
      animation: none;
    }

    @keyframes curtain-beckon {
      0%,
      100% {
        filter: drop-shadow(0 1px 4px rgba(16, 36, 58, 0.55)) drop-shadow(0 0 6px rgba(255, 255, 255, 0));
      }
      50% {
        filter: drop-shadow(0 1px 4px rgba(16, 36, 58, 0.55)) drop-shadow(0 0 26px rgba(255, 255, 255, 0.6));
      }
    }
  }
</style>

<script is:inline>
  (() => {
    const STORE_KEY = "tpc:curtain";
    const root = document.documentElement;
    const curtain = document.getElementById("curtain");
    const key = document.getElementById("curtain-key");
    if (!curtain || !key) return;

    const lift = () => {
      root.dataset.tpcCurtain = "down";
    };

    /* Once someone has been let in, they stay in: the curtain is a first-visit
       greeting, not a lock. */
    let remembered = false;
    try {
      remembered = localStorage.getItem(STORE_KEY) === "down";
    } catch {
      /* Private browsing and the like — the curtain simply shows again. */
    }
    if (remembered) {
      lift();
      return;
    }

    let leaving = false;
    key.addEventListener("click", () => {
      if (leaving) return;
      leaving = true;

      /* Written before the animation, so a reload mid-exit still lands inside. */
      try {
        localStorage.setItem(STORE_KEY, "down");
      } catch {
        /* Nothing to do — the visitor just meets the curtain again next time. */
      }

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        lift();
        return;
      }

      /* The logo shrinks into the middle first, then the photos dissolve out
         from under it to hand the page over. */
      curtain.dataset.exiting = "";

      const cells = Array.from(curtain.querySelectorAll(".curtain__cell[data-shown]"));
      for (let i = cells.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [cells[i], cells[j]] = [cells[j], cells[i]];
      }

      const dissolve = Math.max(4, Math.round(700 / (cells.length || 1)));
      window.setTimeout(() => {
        cells.forEach((cell, i) => {
          window.setTimeout(() => cell.removeAttribute("data-shown"), i * dissolve);
        });
      }, 480);

      window.setTimeout(() => {
        curtain.dataset.lifting = "";
      }, 1320);
      window.setTimeout(lift, 1800);
    });
  })();
</script>

<script is:inline>
  (() => {
    const mosaic = document.getElementById("curtain-mosaic");
    const payload = document.getElementById("curtain-tiles");
    const curtain = document.getElementById("curtain");
    if (!mosaic || !payload || !curtain) return;
    if (document.documentElement.dataset.tpcCurtain === "down") return;

    /** @type {{ src: string }[]} */
    let sources = [];
    try {
      sources = JSON.parse(payload.textContent || "[]");
    } catch {
      /* No tiles is a fine outcome — the curtain simply stays blank white. */
    }
    if (!sources.length) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const shuffle = (items) => {
      const out = items.slice();
      for (let i = out.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [out[i], out[j]] = [out[j], out[i]];
      }
      return out;
    };

    /**
     * Deals photos from a reshuffled deck rather than picking at random, so the
     * whole membership is on screen before anyone's frame shows up twice.
     */
    const dealer = () => {
      let deck = [];
      return () => {
        if (!deck.length) deck = shuffle(sources);
        return deck.pop();
      };
    };

    let timer = 0;
    const build = () => {
      window.clearTimeout(timer);
      delete curtain.dataset.ready;
      mosaic.textContent = "";

      const target = window.innerWidth < 640 ? 88 : 132;
      const cols = Math.max(2, Math.round(window.innerWidth / target));
      const cell = window.innerWidth / cols;
      const rows = Math.ceil(window.innerHeight / cell);

      mosaic.style.setProperty("--curtain-cols", String(cols));
      mosaic.style.setProperty("--curtain-cell", `${cell}px`);

      const draw = dealer();
      const cells = [];
      for (let i = 0; i < cols * rows; i += 1) {
        const div = document.createElement("div");
        div.className = "curtain__cell";
        div.style.backgroundImage = `url("${draw().src}")`;
        mosaic.append(div);
        cells.push(div);
      }

      const order = shuffle(cells);
      if (reduced) {
        order.forEach((div) => div.setAttribute("data-shown", ""));
        curtain.dataset.ready = "";
        return;
      }

      /* Spread the fill over roughly the same stretch of time no matter how
         many cells the viewport asked for. */
      const step = Math.max(16, Math.round(5000 / order.length));
      let next = 0;
      const reveal = () => {
        order[next].setAttribute("data-shown", "");
        next += 1;
        if (next < order.length) {
          timer = window.setTimeout(reveal, step);
          return;
        }
        /* Every frame is on screen: let the logo start beckoning. */
        curtain.dataset.ready = "";
      };
      timer = window.setTimeout(reveal, 150);
    };

    build();

    let resizeTimer = 0;
    let lastWidth = window.innerWidth;
    let lastHeight = window.innerHeight;
    window.addEventListener("resize", () => {
      /* Mobile browsers fire resize as the URL bar hides; only a real change in
         layout is worth throwing away a half-filled mosaic. */
      if (Math.abs(window.innerWidth - lastWidth) < 40 && Math.abs(window.innerHeight - lastHeight) < 120) {
        return;
      }
      lastWidth = window.innerWidth;
      lastHeight = window.innerHeight;
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(build, 250);
    });
  })();
</script>
