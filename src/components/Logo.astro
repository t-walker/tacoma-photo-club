---
import { Image } from "astro:assets";
import logo from "../images/brand/tpc-logo-full.png";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Image
  class={className}
  src={logo}
  alt="Tacoma Photo Club"
  widths={[240, 360, 480, 720]}
  sizes="(min-width: 900px) 300px, 46vw"
  loading="eager"
/>
