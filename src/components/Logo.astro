---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Wordmark + badge lockup, sized like the MUSTANG/Ford oval in the original ad. -->
<svg
  class={className}
  viewBox="0 0 340 96"
  role="img"
  aria-label="Tacoma Photo Club"
  xmlns="http://www.w3.org/2000/svg"
>
  <g fill="#191612" font-family="Archivo, Helvetica, Arial, sans-serif" font-weight="700">
    <text x="0" y="44" font-size="30" letter-spacing="2">TACOMA</text>
    <text x="0" y="80" font-size="21" letter-spacing="2">PHOTO CLUB</text>
  </g>
  <rect x="0" y="52" width="176" height="3" fill="#191612" />

  <ellipse cx="272" cy="48" rx="66" ry="38" fill="#c8501e" />
  <ellipse cx="272" cy="48" rx="59" ry="31.5" fill="none" stroke="#f3ecdb" stroke-width="1.75" />

  <g stroke="#f3ecdb" fill="none">
    <circle cx="272" cy="42" r="14" stroke-width="2.5" />
    <path d="M272 28 L284 49 M272 28 L260 49 M284 49 L260 49" stroke-width="1.75" />
  </g>
  <text
    x="272"
    y="72"
    text-anchor="middle"
    font-family="Archivo, Helvetica, Arial, sans-serif"
    font-size="9"
    font-weight="700"
    letter-spacing="3.5"
    fill="#f3ecdb"
  >EST. TACOMA</text>
</svg>
