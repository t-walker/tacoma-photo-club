---
import site from "../data/site.json";
import { getMemberPhotos } from "../lib/images";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

/**
 * Portrait member work, rotated in the browser the same way the home page
 * plates are, so a cached page still shuffles. Falls back to a text-only ad
 * while `src/images/members/` is empty.
 */
const photos = await getMemberPhotos();
const first = photos[0];
---

<aside class="classified" data-has-photo={photos.length > 0 ? "" : undefined}>
  <div class="classified__body">
    <p class="classified__kicker">Classified</p>
    <h2 class="classified__title">Join the club!</h2>
    <ul class="classified__list">
      <li>Turn up to anything on the <a href={withBase("/events/")}>Events page</a> — no sign-up, no dues.</li>
      <li>Bring whatever you shoot. Film, digital, phone, pinhole.</li>
      <li>
        Say hello in the{" "}
        <a href={site.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>.
      </li>
      {
        site.instagram && (
          <li>
            Follow along on{" "}
            <a href={site.instagram} target="_blank" rel="noopener noreferrer">
              Instagram
            </a>
            .
          </li>
        )
      }
    </ul>
  </div>

  {
    first ? (
      <figure class="classified__photo">
        <img
          id="classified-photo"
          src={first.src}
          width={first.width}
          height={first.height}
          alt={`A photograph by ${first.credit.name}`}
          loading="lazy"
        />
        <figcaption class="credit" id="classified-credit">
          <span class="credit__name">{first.credit.name}</span>
          {first.credit.instagram ? (
            <a
              class="credit__handle"
              href={first.credit.instagram}
              target="_blank"
              rel="noopener noreferrer"
            >
              @{first.credit.handle}
            </a>
          ) : (
            <span class="credit__handle">@{first.credit.handle}</span>
          )}
        </figcaption>
      </figure>
    ) : null
  }
</aside>

{
  photos.length > 1 ? (
    <script is:inline define:vars={{ photos }}>
      (function () {
        var img = document.getElementById("classified-photo");
        var box = document.getElementById("classified-credit");
        if (!img || !box) return;

        var pick = photos[Math.floor(Math.random() * photos.length)];
        if (!pick) return;

        img.src = pick.src;
        img.width = pick.width;
        img.height = pick.height;
        img.alt = "A photograph by " + pick.credit.name;

        box.querySelector(".credit__name").textContent = pick.credit.name;

        var handle = box.querySelector(".credit__handle");
        var wantsLink = Boolean(pick.credit.instagram);
        if (wantsLink !== (handle.tagName === "A")) {
          var next = document.createElement(wantsLink ? "a" : "span");
          next.className = "credit__handle";
          handle.replaceWith(next);
          handle = next;
        }
        if (wantsLink) {
          handle.href = pick.credit.instagram;
          handle.target = "_blank";
          handle.rel = "noopener noreferrer";
        }
        handle.textContent = "@" + pick.credit.handle;
      })();
    </script>
  ) : null
}
