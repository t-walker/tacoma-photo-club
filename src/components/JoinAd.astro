---
import site from "../data/site.json";
import MemberPhoto from "./MemberPhoto.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---

<aside class="classified">
  <div class="classified__body">
    <p class="classified__kicker">Classifieds</p>
    <h2 class="classified__title">Join the club!</h2>
    <ul class="classified__list">
      <li>Join us at one of our monthly events listed on the <a href={withBase("/events/")}>Events page</a>.</li>
      <li>No registrations, sign-ups, or dues.</li>
      <li>Bring whatever camera you've got.</li>
      <li>
        Chat with the community on {" "}
        <a href={site.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>.
      </li>
      {
        site.instagram && (
          <li>
            Follow us on{" "}
            <a href={site.instagram} target="_blank" rel="noopener noreferrer">
              Instagram
            </a>
            .
          </li>
        )
      }
    </ul>
  </div>

  <MemberPhoto id="classified-photo" class="classified__photo" />
</aside>
