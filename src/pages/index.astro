---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import JoinAd from "../components/JoinAd.astro";
import site from "../data/site.json";
import { getHeroSources } from "../lib/images";
import { getEvents, getNextEvent, getRecentEvents } from "../lib/events";

const heroSources = await getHeroSources();
const fallbackTop = heroSources[0];
const fallbackBottom = heroSources[1] ?? heroSources[0];

const base = import.meta.env.BASE_URL;
const eventsHref = `${base.replace(/\/$/, "")}/events/`;

const events = getEvents();
const nextEvent = getNextEvent(events);
const recentEvents = getRecentEvents(events);

/* Between seasons the slot shows a night we have already had rather than
   collapsing the third column. */
const featured = nextEvent ?? recentEvents[0];

/**
 * Everything the slot might show, pre-rendered to a flat payload so the browser
 * can re-pick against the visitor's clock — a page cached past the featured
 * event's date would otherwise advertise something already shot.
 */
const eventCards = await Promise.all(
  [...events.filter((event) => event.status === "upcoming"), ...recentEvents].map(async (event) => ({
    id: event.id,
    date: event.date,
    title: event.title,
    location: event.location,
    meta: `${event.dateLabel}${event.timeLabel ? ` · ${event.timeLabel}` : ""}`,
    src: event.flierImage
      ? (await getImage({ src: event.flierImage, width: 540, format: "webp" })).src
      : "",
  })),
);
---

<Base>
  <figure class="plate plate--hero">
    <img
      id="plate-top"
      alt="A photograph by a Tacoma Photo Club member"
      width={fallbackTop?.width}
      height={fallbackTop?.height}
      fetchpriority="high"
    />
    <noscript>
      <img src={fallbackTop?.src} alt="A photograph by a Tacoma Photo Club member" />
    </noscript>
    <figcaption class="credit" id="credit-top">
      <span class="credit__name">{fallbackTop?.credit.name}</span>
      {
        fallbackTop?.credit.instagram ? (
          <a class="credit__handle" href={fallbackTop.credit.instagram} target="_blank" rel="noopener noreferrer">
            @{fallbackTop.credit.handle}
          </a>
        ) : (
          <span class="credit__handle">@{fallbackTop?.credit.handle}</span>
        )
      }
    </figcaption>
  </figure>
  <br />
  <h1 class="headline headline--script">{site.slogan}</h1>

  <div class="copy-row">
    <div class="copy">
      <Logo class="copy__logo" />
      <p>
        Founded in 2023 by Matt Wade, Melissa Jividan, and Adam Repp the Tacoma Photo club has been a cornerstone of the Tacoma arts scene.
        We host free monthly meetups for anyone interested in attending! This club is open to photographers of all skill levels and backgrounds.
        Our members range from nature enthusiasts to heavy-metal concert photographers. 
      </p>
      <p>
        The photo club has many partners throughout the region including the Tacoma Photo Center and other film and photo clubs.
        Anyone who is interested in starting with digital or film photography will find plenty of folks to talk to (...good luck getting them to stop!)
      </p>
      <p>
        We invite you to connect with us on Instagram to stay up-to-date on our events and other events going on in the community.
        On our Discord server folks share their work, trade and buy/sell gear, and share knowledge with the rest of the club.
      </p>
      <p>
        Whether you have 1 camera or 100 or whether you've been in Washington for a few days or a few years we'd love to see you at our next meetup.
      </p>

      <p class="copy__cta">
        You should follow us on <a href={site.instagram} target="_blank">Instagram</a> and join our <a href={site.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a> server.
      </p>
    </div>

    {
      featured ? (
        <aside class="next-up" id="home-next-up" data-next-for={featured.id}>
          <p class="next-up__kicker" id="home-next-up-kicker">
            {nextEvent ? "Next up" : "Past event"}
          </p>
          <a class="next-up__link" href={eventsHref}>
            <figure class="next-up__flier">
              {featured.flierImage ? (
                <Image
                  src={featured.flierImage}
                  alt={`Flier for ${featured.title}`}
                  widths={[320, 540]}
                  sizes="(min-width: 720px) 300px, 90vw"
                  loading="lazy"
                />
              ) : null}
            </figure>
            <h2 class="next-up__title">{featured.title}</h2>
          </a>
          <p class="next-up__meta">
            {featured.dateLabel}
            {featured.timeLabel ? ` · ${featured.timeLabel}` : ""}
            <br />
            {featured.location}
          </p>
        </aside>
      ) : null
    }
  </div>

  <JoinAd />

  <script is:inline define:vars={{ eventCards }}>
    // The page is static, so the event baked in at build time can go stale.
    // Re-pick against the visitor's clock: the soonest night still ahead of
    // them, or — with nothing on the calendar — a recent one from the archive.
    (function () {
      var box = document.getElementById("home-next-up");
      if (!box) return;

      var now = Date.now();
      var cards = (eventCards || []).filter(function (card) {
        return !isNaN(new Date(card.date).getTime());
      });

      var upcoming = cards
        .filter(function (card) {
          return new Date(card.date).getTime() >= now;
        })
        .sort(function (a, b) {
          return new Date(a.date) - new Date(b.date);
        });

      var pick = upcoming[0];
      var kicker = "Next up";

      if (!pick) {
        var recent = cards
          .sort(function (a, b) {
            return new Date(b.date) - new Date(a.date);
          })
          .slice(0, 6);
        pick = recent[Math.floor(Math.random() * recent.length)];
        kicker = "Past event";
      }

      if (!pick) {
        box.hidden = true;
        return;
      }

      var kickerBox = document.getElementById("home-next-up-kicker");
      if (kickerBox) kickerBox.textContent = kicker;

      if (box.getAttribute("data-next-for") === pick.id) return;

      var img = box.querySelector(".next-up__flier img");
      if (img && pick.src) {
        img.removeAttribute("srcset");
        img.removeAttribute("sizes");
        img.src = pick.src;
        img.alt = "Flier for " + pick.title;
      }

      var title = box.querySelector(".next-up__title");
      if (title) title.textContent = pick.title;

      var meta = box.querySelector(".next-up__meta");
      if (meta) {
        meta.textContent = "";
        meta.appendChild(document.createTextNode(pick.meta));
        meta.appendChild(document.createElement("br"));
        meta.appendChild(document.createTextNode(pick.location));
      }

      box.setAttribute("data-next-for", pick.id);
    })();
  </script>

  <p class="script script--left">
    Photo walks, meetups & side-quests<br />
    all year long — see the <a href={eventsHref}>Events page</a>.
  </p>

  <figure class="plate plate--second">
    <img
      id="plate-bottom"
      alt="A photograph by a Tacoma Photo Club member"
      width={fallbackBottom?.width}
      height={fallbackBottom?.height}
      loading="lazy"
    />
    <noscript>
      <img src={fallbackBottom?.src} alt="A photograph by a Tacoma Photo Club member" />
    </noscript>
    <figcaption class="credit" id="credit-bottom">
      <span class="credit__name">{fallbackBottom?.credit.name}</span>
      {
        fallbackBottom?.credit.instagram ? (
          <a class="credit__handle" href={fallbackBottom.credit.instagram} target="_blank" rel="noopener noreferrer">
            @{fallbackBottom.credit.handle}
          </a>
        ) : (
          <span class="credit__handle">@{fallbackBottom?.credit.handle}</span>
        )
      }
    </figcaption>
  </figure>

  <script is:inline define:vars={{ heroSources }}>    // Two different photos, re-drawn on every page load. Sources come from
    // src/images/hero/ at build time; the pick happens in the browser so a
    // cached page still shuffles.
    (function () {
      var pool = heroSources || [];
      if (pool.length === 0) return;

      var first = Math.floor(Math.random() * pool.length);
      var second =
        pool.length > 1
          ? (first + 1 + Math.floor(Math.random() * (pool.length - 1))) % pool.length
          : first;

      function apply(id, creditId, pick) {
        var el = document.getElementById(id);
        if (!el || !pick) return;
        el.width = pick.width;
        el.height = pick.height;
        el.src = pick.src;

        var credit = pick.credit;
        var box = document.getElementById(creditId);
        if (!box || !credit) return;

        el.alt = "A photograph by " + credit.name;
        box.querySelector(".credit__name").textContent = credit.name;

        var handle = box.querySelector(".credit__handle");
        var wantsLink = Boolean(credit.instagram);
        if (wantsLink !== (handle.tagName === "A")) {
          var replacement = document.createElement(wantsLink ? "a" : "span");
          replacement.className = "credit__handle";
          handle.replaceWith(replacement);
          handle = replacement;
        }
        handle.textContent = "@" + credit.handle;
        if (wantsLink) {
          handle.href = credit.instagram;
          handle.target = "_blank";
          handle.rel = "noopener noreferrer";
        }
      }

      apply("plate-top", "credit-top", pool[first]);
      apply("plate-bottom", "credit-bottom", pool[second]);
    })();
  </script>
</Base>
