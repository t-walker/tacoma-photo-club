---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import MemberPhoto from "../components/MemberPhoto.astro";
import { getEvents, getNextEvent } from "../lib/events";

const events = getEvents();
const nextEvent = getNextEvent(events);

const stampLabels: Record<string, string> = {
  upcoming: "Upcoming",
  past: "Past",
};

/**
 * Full-size group shots for the lightbox. Optimised here at build time so the
 * viewer swaps in a ready URL rather than blowing the thumbnail up.
 */
const groupFulls = new Map(
  await Promise.all(
    events
      .filter((event) => event.groupImage)
      .map(
        async (event) =>
          [
            event.id,
            await getImage({ src: event.groupImage!, width: 1800, format: "webp" }),
          ] as const,
      ),
  ),
);
---

<Base title="Events" description="Photo walks, darkroom nights and critiques from the Tacoma Photo Club.">
  <header class="page-head">
    <div class="page-head__text">
      <p class="eyebrow">The calendar</p>
      <h1 class="headline">Events</h1>
      <p class="lede">
        Come hang out with us at one of our upcoming events and see what our members have loved in the past!
      </p>
    </div>
    <MemberPhoto id="events-photo" class="page-head__photo" />
  </header>

  {
    nextEvent ? (
      <section class="featured" id="featured" data-featured-for={nextEvent.id}>
        <p class="featured__stamp">Next up</p>
        <div class="featured__inner" id="featured-inner">
          <figure class="featured__flier">
            {nextEvent.flierImage ? (
              <Image
                src={nextEvent.flierImage}
                alt={`Flier for ${nextEvent.title}`}
                widths={[320, 640, 960]}
                sizes="(min-width: 720px) 270px, 90vw"
                loading="eager"
              />
            ) : null}
          </figure>
          <div class="featured__body">
            <h2 class="featured__title">
              {nextEvent.url ? (
                <a href={nextEvent.url} target="_blank" rel="noopener noreferrer">
                  {nextEvent.title}
                </a>
              ) : (
                nextEvent.title
              )}
            </h2>
            <p class="featured__meta">
              {nextEvent.dateLabel}
              {nextEvent.timeLabel ? ` · ${nextEvent.timeLabel}` : ""}
              <br />
              {nextEvent.location}
            </p>
            <p class="featured__desc">{nextEvent.description}</p>
          </div>
        </div>
      </section>
    ) : null
  }

  {nextEvent ? null : <hr class="rule" />}

  {
    events.length === 0 ? (
      <p class="empty">Nothing on the books just yet — check the Discord.</p>
    ) : (
      <ul class="events" id="events-grid">
        {events.map((event) => (
          <li class="event" data-id={event.id} data-status={event.status} data-date={event.date}>
            <figure class="event__flier">
              {event.flierImage ? (
                <Image
                  src={event.flierImage}
                  alt={`Flier for ${event.title}`}
                  widths={[320, 640, 960]}
                  sizes="(min-width: 1080px) 240px, (min-width: 640px) 33vw, 90vw"
                  loading="lazy"
                />
              ) : null}
              {event.groupImage ? (
                <button
                  class="event__group"
                  type="button"
                  data-full={groupFulls.get(event.id)?.src}
                  data-caption={`${event.title} — ${event.dateLabel}`}
                  aria-label={`See the group photo from ${event.title} full size`}
                >
                  <Image
                    src={event.groupImage}
                    alt={`Club members at ${event.title}`}
                    widths={[320, 640]}
                    sizes="(min-width: 1080px) 200px, 40vw"
                    loading="lazy"
                  />
                </button>
              ) : null}
              <span class="event__stamp">{stampLabels[event.status]}</span>
            </figure>
            <h2 class="event__title">
              {event.url ? (
                <a href={event.url} target="_blank" rel="noopener noreferrer">
                  {event.title}
                </a>
              ) : (
                event.title
              )}
            </h2>
            <p class="event__meta">
              {event.dateLabel}
              {event.timeLabel ? ` · ${event.timeLabel}` : ""}
              <br />
              {event.location}
            </p>
            <p class="event__desc">{event.description}</p>
          </li>
        ))}
      </ul>
    )
  }

  <script is:inline>
    // The page is static, so an event can go stale between builds. Recompute the
    // upcoming/past split and re-pick the featured event against the visitor's
    // clock. Grid order is already newest-first and never changes.
    (function () {
      var grid = document.getElementById("events-grid");
      if (!grid) return;

      var now = Date.now();
      var items = Array.prototype.slice.call(grid.children);
      var soonest = null;

      items.forEach(function (li) {
        var time = new Date(li.getAttribute("data-date") || "").getTime();
        if (isNaN(time)) return;

        var status = time < now ? "past" : "upcoming";
        li.setAttribute("data-status", status);
        var stamp = li.querySelector(".event__stamp");
        if (stamp) stamp.textContent = status === "past" ? "Past" : "Upcoming";

        // Newest first, so the last upcoming item we see is the soonest one.
        if (status === "upcoming") soonest = li;
      });

      var featured = document.getElementById("featured");
      if (!featured) return;

      if (!soonest) {
        featured.hidden = true;
        return;
      }

      if (featured.getAttribute("data-featured-for") === soonest.getAttribute("data-id")) return;

      // Build the featured block from the grid entry that is actually next.
      var inner = document.getElementById("featured-inner");
      if (!inner) return;

      var flier = inner.querySelector(".featured__flier");
      var sourceImg = soonest.querySelector(".event__flier > img");
      if (flier) {
        flier.innerHTML = "";
        if (sourceImg) {
          var img = sourceImg.cloneNode(true);
          img.setAttribute("sizes", "(min-width: 720px) 270px, 90vw");
          img.setAttribute("loading", "eager");
          flier.appendChild(img);
        }
      }

      var fields = [
        [".featured__title", ".event__title"],
        [".featured__meta", ".event__meta"],
        [".featured__desc", ".event__desc"],
      ];
      fields.forEach(function (pair) {
        var target = inner.querySelector(pair[0]);
        var source = soonest.querySelector(pair[1]);
        if (target && source) target.innerHTML = source.innerHTML;
      });

      featured.setAttribute("data-featured-for", soonest.getAttribute("data-id") || "");
      featured.hidden = false;
    })();
  </script>

  <dialog class="lightbox" id="lightbox">
    <form method="dialog">
      <button class="lightbox__close" aria-label="Close">&times;</button>
    </form>
    <img class="lightbox__img" id="lightbox-img" alt="" />
    <p class="lightbox__caption" id="lightbox-caption"></p>
  </dialog>

  <script is:inline>
    // Group shots reveal on hover; clicking one opens it full size. <dialog>
    // handles Esc, focus trapping and returning focus for us.
    (function () {
      var grid = document.getElementById("events-grid");
      var box = document.getElementById("lightbox");
      var img = document.getElementById("lightbox-img");
      var caption = document.getElementById("lightbox-caption");
      if (!grid || !box || !img || !caption || !box.showModal) return;

      grid.addEventListener("click", function (event) {
        var trigger = event.target.closest(".event__group");

        // A click on the flier around the photo puts it away instead, so the
        // flier is readable without moving the pointer off the card.
        if (!trigger) {
          var flier = event.target.closest(".event__flier");
          var card = flier && flier.closest(".event");
          if (card && card.querySelector(".event__group")) {
            card.setAttribute("data-group-dismissed", "");
          }
          return;
        }

        var full = trigger.getAttribute("data-full");
        var thumb = trigger.querySelector("img");
        if (!full && !thumb) return;

        event.preventDefault();
        img.src = full || thumb.currentSrc || thumb.src;
        img.alt = thumb ? thumb.alt : "";
        caption.textContent = trigger.getAttribute("data-caption") || "";
        box.showModal();
      });

      // Bound per card rather than delegated: mouseleave does not bubble, and
      // capturing it on the grid would also fire as the pointer moved between
      // a card's own children, re-arming the photo too early.
      Array.prototype.forEach.call(grid.querySelectorAll(".event"), function (card) {
        card.addEventListener("mouseleave", function () {
          card.removeAttribute("data-group-dismissed");
        });

        card.addEventListener("focusout", function (event) {
          if (!card.contains(event.relatedTarget)) {
            card.removeAttribute("data-group-dismissed");
          }
        });
      });

      // Clicking the backdrop closes it. The dialog fills the viewport, so
      // anything outside the image or its caption counts as backdrop.
      box.addEventListener("click", function (event) {
        if (event.target === box) box.close();
      });

      // Drop the source once it is closed, so a big photo is not held in memory.
      box.addEventListener("close", function () {
        img.removeAttribute("src");
      });
    })();
  </script>
</Base>
