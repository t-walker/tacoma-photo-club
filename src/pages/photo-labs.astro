---
import Base from "../layouts/Base.astro";
import MemberPhoto from "../components/MemberPhoto.astro";
import labs from "../data/photo-labs.json";
import site from "../data/site.json";


type Lab = {
  name: string;
  location: string;
  milesFromTacoma?: number | null;
  capabilities: string[];
  priceRange: string;
  dropOff: string;
  dropBoxes?: string[];
  mailIn: boolean;
  turnaround?: string;
  url?: string;
  notes?: string;
};

const entries = (labs as Lab[])
  .slice()
  .sort((a, b) => {
    // Nearest to Tacoma first; mail-order-only labs (no distance) bring up the rear.
    const aMiles = a.milesFromTacoma ?? Number.POSITIVE_INFINITY;
    const bMiles = b.milesFromTacoma ?? Number.POSITIVE_INFINITY;
    return aMiles - bMiles || a.name.localeCompare(b.name);
  });
---

<Base
  title="Photo Labs"
  description="Where Tacoma Photo Club members get film developed and scanned — capabilities, prices, drop-off and mail-in."
>
  <header class="page-head">
    <div class="page-head__text">
      <p class="eyebrow">Friends of Ours</p>
      <h1 class="headline">Photo Labs</h1>
      <p class="lede">
        Here are some of the places we've sent our film with a basic run-down on each lab; ordered by driving distance to Tacoma. 
        If we're missing something, <a href={site.instagram} target="_blank" rel="noopener noreferrer">shoot us a DM</a> on Instagram.
      </p>
    </div>
    <MemberPhoto id="labs-photo" class="page-head__photo" />
  </header>

  {
    entries.length === 0 ? (
      <p class="empty">No labs listed yet.</p>
    ) : (
      <ul class="labs">
        {entries.map((lab) => (
          <li class="lab">
            <h2 class="lab__name">
              {lab.url ? (
                <a href={lab.url} target="_blank" rel="noopener noreferrer">
                  {lab.name}
                </a>
              ) : (
                lab.name
              )}
            </h2>
            <p class="lab__where">
              {lab.location} · {lab.priceRange}
            </p>

            <dl class="spec">
              <dt>Process</dt>
              <dd>
                <ul class="tags">
                  {lab.capabilities.map((capability) => (
                    <li>{capability}</li>
                  ))}
                </ul>
              </dd>

              {lab.dropOff ? (
                <>
                  <dt>Drop off</dt>
                  <dd>{lab.dropOff}</dd>
                </>
              ) : null}

              {lab.dropBoxes?.length ? (
                <>
                  <dt>Drop boxes</dt>
                  <dd>
                    <ul class="places">
                      {lab.dropBoxes.map((place) => (
                        <li>{place}</li>
                      ))}
                    </ul>
                  </dd>
                </>
              ) : null}

              <dt>Mail in</dt>
              <dd>
                <span class={`badge ${lab.mailIn ? "badge--yes" : "badge--no"}`}>
                  {lab.mailIn ? "Accepted" : "Not accepted"}
                </span>
              </dd>

              {lab.turnaround ? (
                <>
                  <dt>Turnaround</dt>
                  <dd>{lab.turnaround}</dd>
                </>
              ) : null}

              {lab.notes ? (
                <>
                  <dt>Notes</dt>
                  <dd>{lab.notes}</dd>
                </>
              ) : null}
            </dl>
          </li>
        ))}
      </ul>
    )
  }
</Base>
